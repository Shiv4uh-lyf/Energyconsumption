# EnerSight AI — Frontend Environment Variables Example
# Copy to .env.local for local development. Never commit .env.local to git.

# Backend URL used by browser-side API calls.
# For local development:
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend URL used by Next.js server-side rewrites (not exposed to browser).
# For local development:
BACKEND_INTERNAL_URL=http://localhost:8000

# For Render production, set both to the backend's public Render URL:
# NEXT_PUBLIC_API_URL=https://energysight-backend.onrender.com
# BACKEND_INTERNAL_URL=https://energysight-backend.onrender.com
