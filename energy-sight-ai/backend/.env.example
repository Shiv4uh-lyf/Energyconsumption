# EnerSight AI — Backend Environment Variables Example
# Copy to .env and fill in values. Never commit .env to git.

# Python settings
PYTHONUNBUFFERED=1

# CORS: comma-separated list of allowed frontend origins
# Leave empty to use the defaults (Render frontend URL + localhost:3000)
CORS_ORIGINS=https://energysight-frontend.onrender.com,http://localhost:3000

# Optional: OpenAI API key for future AI copilot LLM integration
# OPENAI_API_KEY=sk-...
